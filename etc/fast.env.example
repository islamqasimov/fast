# F.A.S.T. - runtime configuration (committed template)
# Copy this file to `etc/fast.env` and let the installer fill the
# secret references. Do NOT commit `etc/fast.env`.

# ----- Mode -----
# capstone demo defaults to "online" on the host; flip to "offline" for
# offline labs (fixtures only).
TALON_MODE=online

# ----- Network -----
# Hostname the Wazuh dashboard reports under.
FAST_HOSTNAME=fast.local

# Dashboard port (host-published only when --expose-dashboard is passed).
WAZUH_DASHBOARD_PORT=443

# ----- Wazuh user accounts (references to files under secrets/, never plaintext) -----
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD_FILE=secrets/wazuh_indexer_password
WAZUH_DASHBOARD_USERNAME=admin
WAZUH_DASHBOARD_PASSWORD_FILE=secrets/wazuh_admin_password
WAZUH_API_PASSWORD_FILE=secrets/wazuh_api_password

# ----- Wazuh passwords (plaintext, populated by installer; never commit) -----
# Wazuh's manager and dashboard entrypoints do not support _FILE suffix for
# INDEXER_PASSWORD / DASHBOARD_PASSWORD / API_PASSWORD. They must be passed
# as plaintext env vars. The installer copies these from secrets/*.password
# into etc/fast.env after generation. Do not commit the populated etc/fast.env.
WAZUH_INDEXER_PASSWORD=
WAZUH_DASHBOARD_PASSWORD=
WAZUH_API_PASSWORD=

# ----- T.A.L.O.N. -----
# Source feeds (T2.3): Feodo Tracker, URLhaus, MalwareBazaar, Spamhaus DROP.
TALON_FEEDS=feodo_tracker,urlhaus,malwarebazaar,spamhaus_drop

# Run mode. cron uses --mode online. Demo uses --mode offline.
TALON_DEFAULT_MODE=online

# ----- Cron -----
# Daily run time in host local time. ±15 minutes jitter applied at install.
TALON_CRON_HOUR=2
TALON_CRON_MINUTE=30
# Disable with --no-cron at install time.
TALON_CRON_ENABLED=true

# ----- Install behaviour -----
# If true, the installer creates /etc/sudoers.d/fast-docker for passwordless
# docker invocations. Disable on multi-tenant hosts.
FAST_DOCKER_SUDOERS=true
