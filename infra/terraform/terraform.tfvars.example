# Bu faylı kopyala: cp terraform.tfvars.example terraform.tfvars
# Sonra öz GCP məlumatlarınla doldur.
# terraform.tfvars faylı .gitignore-dadır - HEÇ VAXT git-ə commit ETMƏ.

project_id       = "wazuh-lab-123456"          # GCP Console -> Project Info -> Project ID
region            = "us-central1"
zone              = "us-central1-a"
credentials_file = "~/.gcp/wazuh-lab-key.json" # Service Account JSON key

ssh_username         = "wazuhadmin"
ssh_public_key_path = "~/.ssh/gcp_wazuh_key.pub"

# https://ifconfig.me ünvanına gedib öz public IP-ni tap, /32 əlavə et
my_public_ip = "1.2.3.4/32"

deploy_linux_target = true   # Ubuntu Wazuh Agent test üçün
