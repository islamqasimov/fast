#!/bin/bash
# Bu fayl Ansible tərəfindən avtomatik yaradılıb.
# Tam OSINT -> Wazuh axınını işə salır: fetch -> normalize -> db -> CDB export -> manager-ə göndər.
# Cron tərəfindən gündəlik çağırılır (bax: roles/ioc-integration/tasks/main.yml).

set -e

PROJECT_DIR="/opt/osint-ioc-collector"
LOG_FILE="/var/log/osint-wazuh-pipeline.log"
WAZUH_MANAGER_HOST="{{ hostvars['wazuh-manager']['ansible_host'] }}"
WAZUH_MANAGER_USER="{{ ansible_user }}"
MIN_CONFIDENCE="{{ ioc_min_confidence | default(25) }}"

echo "===== $(date -u +%Y-%m-%dT%H:%M:%SZ) - Pipeline başladı =====" >> "$LOG_FILE"

cd "$PROJECT_DIR"

# 1. Bazanı hazırla (ilk dəfə üçün, sonrakılarda no-op)
python3 cli.py --init-db >> "$LOG_FILE" 2>&1

# 2. Feed-lərdən yığ, normallaşdır, bazaya yaz (dedup+scoring avtomatik)
python3 cli.py --fetch >> "$LOG_FILE" 2>&1

# 3. Wazuh CDB list formatına export et (yalnız min_confidence-dən yuxarı IP-lər)
python3 -c "
from core import db, wazuh_export
iocs = db.get_all_iocs()
stats = wazuh_export.get_export_stats(iocs, min_confidence=${MIN_CONFIDENCE})
ok = wazuh_export.export_to_cdb_list(iocs, min_confidence=${MIN_CONFIDENCE})
print(f'Export: {stats}')
" >> "$LOG_FILE" 2>&1

# 4. Yaranan CDB faylını Wazuh Manager-ə köçür
scp -i ~/.ssh/gcp_wazuh_key -o StrictHostKeyChecking=no \
    sample_output/ioc-ips \
    "${WAZUH_MANAGER_USER}@${WAZUH_MANAGER_HOST}:/tmp/ioc-ips" >> "$LOG_FILE" 2>&1

# 5. Manager-də faylı düzgün yerə köçür və Wazuh Manager konteynerini restart et
ssh -i ~/.ssh/gcp_wazuh_key -o StrictHostKeyChecking=no \
    "${WAZUH_MANAGER_USER}@${WAZUH_MANAGER_HOST}" \
    "sudo mv /tmp/ioc-ips /opt/wazuh-docker/single-node/config/wazuh_cluster/etc_lists/ioc-ips && \
     cd /opt/wazuh-docker/single-node && sudo docker compose restart wazuh.manager" \
    >> "$LOG_FILE" 2>&1

echo "===== $(date -u +%Y-%m-%dT%H:%M:%SZ) - Pipeline tamamlandı =====" >> "$LOG_FILE"
